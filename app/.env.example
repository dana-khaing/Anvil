# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Settings > API in the Supabase dashboard).
# The anon/publishable key is safe to ship in the client — it's constrained
# by Row Level Security, not a secret on its own.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

{
  "name": "anvil",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first, futuristic workout tracker with AI coaching and streak-based motivation",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["unrs-resolver", "@shopify/react-native-skia", "esbuild"],
    "overrides": {
      "@xmldom/xmldom@0.8": "0.8.15",
      "@xmldom/xmldom@0.9": "0.9.12",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@5": "5.0.12",
      "js-yaml@3": "3.15.2",
      "js-yaml@4": "4.3.2"
    }
  },
  "scripts": {
    "typecheck": "pnpm --filter @anvil/app exec tsc --noEmit",
    "lint": "pnpm --filter @anvil/app lint",
    "test": "pnpm --filter @anvil/app test",
    "start": "pnpm --filter @anvil/app start"
  }
}

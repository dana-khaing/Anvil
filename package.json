{
  "name": "pulseforge",
  "version": "0.0.0",
  "private": true,
  "description": "Offline-first, futuristic workout tracker with AI coaching and streak-based motivation",
  "license": "MIT",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["unrs-resolver", "@shopify/react-native-skia"]
  },
  "scripts": {
    "typecheck": "pnpm --filter @pulseforge/app exec tsc --noEmit",
    "lint": "pnpm --filter @pulseforge/app lint",
    "test": "pnpm --filter @pulseforge/app test",
    "start": "pnpm --filter @pulseforge/app start"
  }
}
